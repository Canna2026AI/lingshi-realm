{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/realm",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/realm/",
      "destination": "/",
      "permanent": true
    }
  ]
}
